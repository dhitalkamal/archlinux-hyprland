#!/usr/bin/env bash
# dynamic-workspaces: macos-like "spaces" for hyprland.
#
# keeps your occupied workspaces contiguous (1,2,3,...) and follows you off an
# emptied one, the way macos slides spaces down when one disappears.
#
# on any change that can open or close a gap (window opened/closed/moved, a
# workspace destroyed) it:
#   1. if the workspace you are on just went empty, follows you to the nearest
#      occupied one first (so hyprland frees that now-dead id).
#   2. renumbers the occupied workspaces down to 1..N with no gaps, using
#      hl.dsp.workspace.change_id so an entire workspace (all its windows and
#      layout) is renumbered in one shot and your focus rides along.
#
# NOTE: this hyprland (0.56, lua config) rejects plain `hyprctl dispatch <name>`
# (it evaluates the argument as lua), so every dispatch below uses the hl.dsp.*
# form. verified: plain `dispatch workspace N` errors, `hl.dsp.focus({...})` is ok.
#
# the event loop is DEBOUNCED: renumbering fires its own events, so we coalesce a
# burst and reconcile once after a short quiet period. this prevents a self-cascade
# (change_id into an already-used id would MERGE workspaces).
#
# limits: only normal (positive-id) workspaces; special overlays (scratchterm,
# hidden) are never touched. switching to an empty workspace on purpose does not
# trigger anything, it only reacts when windows actually open/close/move.
set -euo pipefail

# single instance per session
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/dynamic-workspaces.lock"
flock -n 9 || exit 0

sig="${HYPRLAND_INSTANCE_SIGNATURE:-}"
[ -n "$sig" ] || { echo "dynamic-workspaces: not in a hyprland session" >&2; exit 1; }
sock="$XDG_RUNTIME_DIR/hypr/$sig/.socket2.sock"
[ -S "$sock" ] || { echo "dynamic-workspaces: event socket missing: $sock" >&2; exit 1; }

# json array of occupied normal workspace ids, sorted ascending. e.g. [1,2,4]
occupied() {
    hyprctl workspaces -j | jq -c '[ .[] | select(.id > 0 and .windows > 0) | .id ] | sort'
}

reconcile() {
    local aw active awwin occ tgt idx oldws

    # 1. if we are sitting on a now-empty normal workspace, follow to the nearest
    #    occupied one first. that lets hyprland destroy the empty active ws and
    #    free its id, so the renumber below cannot collide (collision == merge).
    aw="$(hyprctl activeworkspace -j)"
    active="$(printf '%s' "$aw" | jq -r '.id')"
    awwin="$(printf '%s' "$aw" | jq -r '.windows')"
    if [[ "$active" =~ ^[0-9]+$ ]] && [ "$awwin" = 0 ]; then
        tgt="$(occupied | jq -r --argjson a "$active" '
            if length == 0 then empty
            else (sort_by([ (. - $a | fabs), . ]) | .[0]) end')"
        if [ -n "$tgt" ]; then
            hyprctl dispatch "hl.dsp.focus({workspace=$tgt})" >/dev/null 2>&1
            sleep 0.05
        fi
    fi

    # 2. renumber occupied workspaces to 1..N (ascending order is collision-free:
    #    each target slot is either already correct or was vacated in an earlier
    #    step). change_id carries all windows and keeps your focus on the ws.
    occ="$(occupied)"
    [ "$(printf '%s' "$occ" | jq 'length')" -gt 0 ] || return 0
    while read -r idx oldws; do
        [ "$oldws" = "$idx" ] && continue
        hyprctl dispatch "hl.dsp.workspace.change_id({workspace=$oldws,id=$idx})" >/dev/null 2>&1
    done < <(printf '%s' "$occ" | jq -r 'to_entries[] | "\(.key + 1) \(.value)"')
    return 0
}

# debounced event loop. process substitution keeps the loop in this shell so the
# `pending` flag persists and there is a single process. read -t distinguishes:
# rc 0 = got a line, rc > 128 = quiet timeout, rc 1 = EOF (socat died -> exit).
pending=0
while true; do
    rc=0; IFS= read -r -t 0.2 line || rc=$?
    if [ "$rc" = 0 ]; then
        case "$line" in
            openwindow\>\>*|closewindow\>\>*|movewindow\>\>*|movewindowv2\>\>*|destroyworkspace\>\>*)
                pending=1 ;;
        esac
    elif [ "$rc" -gt 128 ]; then
        # quiet period: if something changed, reconcile exactly once
        if [ "$pending" = 1 ]; then pending=0; reconcile; fi
    else
        break   # EOF: the event socket closed
    fi
done < <(socat -U - "UNIX-CONNECT:$sock")
