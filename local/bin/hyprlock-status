#!/usr/bin/env bash
# hyprlock-status — one status line for the lockscreen info row.
# Battery · keyboard layout · now-playing · uptime. Each part is independent;
# a failure in any one never breaks the whole line.

sep="     "
parts=()

# --- Battery ---
bat=/sys/class/power_supply/BAT0
if [ -r "$bat/capacity" ]; then
    cap=$(<"$bat/capacity")
    st=$(cat "$bat/status" 2>/dev/null)
    if [ "$st" = "Charging" ]; then
        icon="󰂄"
    elif   [ "$cap" -ge 90 ]; then icon="󰁹"
    elif [ "$cap" -ge 70 ]; then icon="󰂀"
    elif [ "$cap" -ge 40 ]; then icon="󰁾"
    elif [ "$cap" -ge 15 ]; then icon="󰁻"
    else                            icon="󰂎"
    fi
    parts+=("$icon $cap%")
fi

# --- Keyboard layout ---
lay=$(hyprctl getoption input:kb_layout 2>/dev/null | awk -F': ' '/^str:/{print $2}' | cut -d, -f1)
[ -n "$lay" ] && [ "$lay" != "null" ] && parts+=("󰌌 ${lay^^}")


# --- Notifications ---
if command -v swaync-client >/dev/null 2>&1; then
    n=$(swaync-client -c 2>/dev/null)
    [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null && parts+=("󰂚 $n")
fi

# --- Uptime ---
up=$(uptime -p 2>/dev/null | sed 's/up //; s/ hours\?/h/; s/ minutes\?/m/; s/ days\?/d/; s/,//g')
[ -n "$up" ] && parts+=("󰅐 $up")

# Join with the separator
line=""
for p in "${parts[@]}"; do
    [ -n "$line" ] && line+="$sep"
    line+="$p"
done
line=${line//&/&amp;}; line=${line//</&lt;}; line=${line//>/&gt;}
echo "$line"
