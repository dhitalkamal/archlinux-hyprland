#!/usr/bin/env bash
# Advance to the next wallpaper in the collection and re-theme from it.
# Collection dir: $WALLPAPER_DIR (default ~/Pictures/wallpapers).
# Supports images (awww) and videos (mpvpaper) — wall-theme handles both.
DIR="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
STATE="$HOME/.config/hypr/current-wallpaper"

mapfile -t files < <(find "$DIR" -maxdepth 1 \( -type f -o -type l \) \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
       -o -iname '*.mp4' -o -iname '*.mkv' -o -iname '*.webm' \) | sort)

n=${#files[@]}
if [ "$n" -eq 0 ]; then
    notify-send "Wallpaper cycle" "No wallpapers found in $DIR" 2>/dev/null
    exit 1
fi

cur="$(cat "$STATE" 2>/dev/null)"
idx=-1
for i in "${!files[@]}"; do
    [ "${files[$i]}" = "$cur" ] && { idx=$i; break; }
done
next=$(( (idx + 1) % n ))

exec "$HOME/.local/bin/wall-theme" "${files[$next]}"
